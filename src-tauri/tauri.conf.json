{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowster",
  "version": "0.0.1",
  "identifier": "app.flowster.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:wasm && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:wasm && pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flowster",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Diagramming",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_CONTENTS_OF_~/.tauri/flowster-updater.key.pub",
      "endpoints": [
        "https://skuirrels.github.io/flowster-releases/updates/{{target}}-{{arch}}.json",
        "https://skuirrels.github.io/flowster-releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
