{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowster",
  "version": "0.1.4",
  "identifier": "app.flowster.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:wasm && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:wasm && pnpm build && pnpm notices",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flowster",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Diagramming",
    "fileAssociations": [
      {
        "ext": ["vsdx"],
        "name": "Visio Drawing",
        "description": "Visio Drawing",
        "role": "Editor",
        "mimeType": "application/vnd.ms-visio.drawing.main+xml"
      },
      {
        "ext": ["vsdm"],
        "name": "Visio Macro-Enabled Drawing",
        "description": "Visio Macro-Enabled Drawing",
        "role": "Editor",
        "mimeType": "application/vnd.ms-visio.drawing.macroEnabled.main+xml"
      },
      {
        "ext": ["vssx"],
        "name": "Visio Stencil",
        "description": "Visio Stencil",
        "role": "Editor",
        "mimeType": "application/vnd.ms-visio.stencil.main+xml"
      },
      {
        "ext": ["vssm"],
        "name": "Visio Macro-Enabled Stencil",
        "description": "Visio Macro-Enabled Stencil",
        "role": "Editor",
        "mimeType": "application/vnd.ms-visio.stencil.macroEnabled.main+xml"
      },
      {
        "ext": ["vstx"],
        "name": "Visio Template",
        "description": "Visio Template",
        "role": "Editor",
        "mimeType": "application/vnd.ms-visio.template.main+xml"
      },
      {
        "ext": ["vstm"],
        "name": "Visio Macro-Enabled Template",
        "description": "Visio Macro-Enabled Template",
        "role": "Editor",
        "mimeType": "application/vnd.ms-visio.template.macroEnabled.main+xml"
      }
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFMEUyNDg3RTIwNkEyOTMKUldTVG9nYmloeVFPUHVGS2pqTEJLZ2FGeHZkZXNjM2hvdnpLTUl1a2VYRmZBcjRibW4xQmo4N3YK",
      "endpoints": [
        "https://skuirrels.github.io/flowster-releases/updates/{{target}}-{{arch}}.json",
        "https://skuirrels.github.io/flowster-releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
